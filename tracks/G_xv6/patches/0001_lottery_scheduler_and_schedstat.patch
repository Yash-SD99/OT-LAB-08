diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 1de144e..bb99201 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -5,6 +5,7 @@
 #include "memlayout.h"
 #include "spinlock.h"
 #include "proc.h"
+#include "schedstat.h"
 
 uint64
 sys_exit(void)
@@ -89,3 +90,38 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+uint64
+sys_settickets(void)
+{
+  int tickets;
+  argint(0, &tickets);
+  if(tickets <= 0)
+    return -1;
+  struct proc *p = myproc();
+  acquire(&p->lock);
+  p->tickets = tickets;
+  release(&p->lock);
+  return 0;
+}
+
+uint64
+sys_schedstat(void)
+{
+  uint64 addr;
+  argaddr(0, &addr);
+  struct proc *p = myproc();
+  struct schedstat st;
+
+  acquire(&p->lock);
+  st.pid = p->pid;
+  st.tickets = p->tickets;
+  st.ticks_run = p->ticks_run;
+  st.ticks_wait = p->ticks_wait;
+  st.sched_count = p->sched_count;
+  release(&p->lock);
+
+  if(copyout(p->pagetable, addr, (char *)&st, sizeof(st)) < 0)
+    return -1;
+  return 0;
+}
